{
  "name": "minicore-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A static web client for MiniCore Host",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "ws": "8.18.3"
  }
}
